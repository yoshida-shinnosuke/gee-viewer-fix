{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8511"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
